# ── Base de données ──
POSTGRES_USER=archives
POSTGRES_PASSWORD=archives_secret

# ── Backend ──
JWT_SECRET=change-me-in-production

# ── Cookie de session ──
# Le cookie de session (refresh) est marqué "Secure" en production : il n'est transmis qu'en HTTPS.
# Un accès en HTTP pur (sans HTTPS ni reverse proxy TLS) empêche la reconnexion automatique ;
# dans ce cas SEULEMENT, décommenter la ligne suivante pour forcer secure:false.
# COOKIE_SECURE=false

# ── Port d'accès ──
APP_PORT=8080

# ── Sécurité CORS ──
# Origine(s) autorisée(s) à appeler l'API (séparées par des virgules).
# Laisser vide/commenté dans le déploiement standard : le frontend est servi par nginx
# en même origine (proxy /api), donc aucune origine cross-site n'est nécessaire.
# À définir uniquement si l'API est appelée depuis une autre origine (ex. front séparé).
# CORS_ORIGIN=https://archives.lepine-versailles.fr

# ── SMTP (optionnel — invitations par email) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=motdepasse
# SMTP_FROM=noreply@example.com
# APP_URL=https://archives.lepine-versailles.fr
